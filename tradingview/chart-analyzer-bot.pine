//@version=5
indicator("Multi-Timeframe Chart Analyzer & Trade Signal Bot", overlay=true, max_lines_count=200, max_labels_count=200, max_boxes_count=200)

// ============================================================================
// INPUTS
// ============================================================================
grpMTF    = "Multi-Timeframe Trend"
grpEntry  = "Entry Trigger (Chart Timeframe)"
grpRisk   = "Risk Management"
grpCandle = "Candlestick Confirmation"
grpDisp   = "Display / Alerts"

htf1        = input.timeframe("D",  "Higher Timeframe (Macro Trend)", group=grpMTF)
htf2        = input.timeframe("60", "Mid Timeframe (Momentum)",       group=grpMTF)
emaTrendLen = input.int(200, "HTF Trend EMA Length", group=grpMTF)

fastLen  = input.int(21, "Fast EMA (entry TF)", group=grpEntry)
slowLen  = input.int(50, "Slow EMA (entry TF)", group=grpEntry)
rsiLen   = input.int(14, "RSI Length",           group=grpEntry)
rsiOB    = input.int(70, "RSI Overbought",       group=grpEntry)
rsiOS    = input.int(30, "RSI Oversold",         group=grpEntry)
minScore = input.int(4, "Minimum Confluence Score (1-5) to Trigger", minval=1, maxval=5, group=grpEntry)

atrLen    = input.int(14, "ATR Length", group=grpRisk)
slMult    = input.float(1.5, "Stop Loss ATR Multiplier", step=0.1, group=grpRisk)
rrRatio   = input.float(2.0, "Reward:Risk Ratio", step=0.1, group=grpRisk)
useSwing  = input.bool(true, "Use Swing High/Low for Stop Loss (wider of swing vs ATR)", group=grpRisk)
swingLen  = input.int(10, "Swing Lookback Length", group=grpRisk)
expiryBars= input.int(100, "Invalidate Untriggered/Unhit Setup After N Bars (0 = never)", group=grpRisk)

useCandles = input.bool(true, "Require Candlestick Confirmation", group=grpCandle)

showTable  = input.bool(true, "Show Analysis Panel", group=grpDisp)
showTrendBg= input.bool(true, "Shade Background by HTF Trend", group=grpDisp)

// ============================================================================
// MULTI-TIMEFRAME DATA
// ============================================================================
htfClose = request.security(syminfo.tickerid, htf1, close, lookahead=barmerge.lookahead_off)
htfEMA   = request.security(syminfo.tickerid, htf1, ta.ema(close, emaTrendLen), lookahead=barmerge.lookahead_off)
htfBias  = htfClose > htfEMA ? 1 : htfClose < htfEMA ? -1 : 0

midEmaFast = request.security(syminfo.tickerid, htf2, ta.ema(close, fastLen), lookahead=barmerge.lookahead_off)
midEmaSlow = request.security(syminfo.tickerid, htf2, ta.ema(close, slowLen), lookahead=barmerge.lookahead_off)
midBias    = midEmaFast > midEmaSlow ? 1 : midEmaFast < midEmaSlow ? -1 : 0

// ============================================================================
// CHART-TIMEFRAME TREND / MOMENTUM / VOLATILITY
// ============================================================================
emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)

localBias = emaFast > emaSlow ? 1 : -1

// ============================================================================
// CANDLESTICK PATTERN CONFIRMATION
// ============================================================================
bodyHi    = math.max(close, open)
bodyLo    = math.min(close, open)
bodySize  = math.abs(close - open)
upperWick = high - bodyHi
lowerWick = bodyLo - low

bullEngulf    = close > open and close[1] < open[1] and close > open[1] and open < close[1]
bearEngulf    = close < open and close[1] > open[1] and close < open[1] and open > close[1]
hammer        = lowerWick > bodySize * 2 and upperWick < bodySize and close > open
shootingStar  = upperWick > bodySize * 2 and lowerWick < bodySize and close < open

bullCandle = bullEngulf or hammer
bearCandle = bearEngulf or shootingStar

// ============================================================================
// CONFLUENCE SCORING
// ============================================================================
longScore  = (htfBias == 1 ? 1 : 0) + (midBias == 1 ? 1 : 0) + (localBias == 1 ? 1 : 0) + \
             (rsiVal > 40 and rsiVal < rsiOB ? 1 : 0) + ((not useCandles) or bullCandle ? 1 : 0)

shortScore = (htfBias == -1 ? 1 : 0) + (midBias == -1 ? 1 : 0) + (localBias == -1 ? 1 : 0) + \
             (rsiVal < 60 and rsiVal > rsiOS ? 1 : 0) + ((not useCandles) or bearCandle ? 1 : 0)

// ============================================================================
// TRADE STATE
// ============================================================================
var int   tradeDir     = 0     // 0 = flat, 1 = long, -1 = short
var float entryPrice   = na
var float slPrice      = na
var float tpPrice      = na
var int   entryBarIdx  = na

var line  entryLine = na
var line  slLine    = na
var line  tpLine    = na
var box   riskBox   = na
var box   rewardBox = na
var label infoLabel = na

swingLow  = ta.lowest(low, swingLen)
swingHigh = ta.highest(high, swingLen)

longTrigger  = tradeDir == 0 and ta.crossover(emaFast, emaSlow)  and htfBias == 1  and longScore  >= minScore and barstate.isconfirmed
shortTrigger = tradeDir == 0 and ta.crossunder(emaFast, emaSlow) and htfBias == -1 and shortScore >= minScore and barstate.isconfirmed

deleteDrawings() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(riskBox)
        box.delete(riskBox)
    if not na(rewardBox)
        box.delete(rewardBox)
    if not na(infoLabel)
        label.delete(infoLabel)

if longTrigger
    deleteDrawings()
    entryPrice := close
    rawSl = close - atrVal * slMult
    slPrice := useSwing ? math.min(swingLow, rawSl) : rawSl
    riskDist = entryPrice - slPrice
    tpPrice := entryPrice + riskDist * rrRatio
    tradeDir := 1
    entryBarIdx := bar_index

    entryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color=color.new(color.blue, 0), style=line.style_dashed, width=1)
    slLine    := line.new(bar_index, slPrice, bar_index, slPrice, color=color.new(color.red, 0), style=line.style_dashed, width=1)
    tpLine    := line.new(bar_index, tpPrice, bar_index, tpPrice, color=color.new(color.green, 0), style=line.style_dashed, width=1)
    riskBox   := box.new(bar_index, entryPrice, bar_index, slPrice, border_color=color.new(color.white, 100), bgcolor=color.new(color.red, 85))
    rewardBox := box.new(bar_index, tpPrice, bar_index, entryPrice, border_color=color.new(color.white, 100), bgcolor=color.new(color.green, 85))

    infoLabel := label.new(bar_index, slPrice, "LONG\nEntry: " + str.tostring(entryPrice, format.mintick) + "\nSL: " + str.tostring(slPrice, format.mintick) + "\nTP: " + str.tostring(tpPrice, format.mintick) + "\nScore: " + str.tostring(longScore) + "/5", style=label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)

if shortTrigger
    deleteDrawings()
    entryPrice := close
    rawSl = close + atrVal * slMult
    slPrice := useSwing ? math.max(swingHigh, rawSl) : rawSl
    riskDist = slPrice - entryPrice
    tpPrice := entryPrice - riskDist * rrRatio
    tradeDir := -1
    entryBarIdx := bar_index

    entryLine := line.new(bar_index, entryPrice, bar_index, entryPrice, color=color.new(color.blue, 0), style=line.style_dashed, width=1)
    slLine    := line.new(bar_index, slPrice, bar_index, slPrice, color=color.new(color.red, 0), style=line.style_dashed, width=1)
    tpLine    := line.new(bar_index, tpPrice, bar_index, tpPrice, color=color.new(color.green, 0), style=line.style_dashed, width=1)
    riskBox   := box.new(bar_index, slPrice, bar_index, entryPrice, border_color=color.new(color.white, 100), bgcolor=color.new(color.red, 85))
    rewardBox := box.new(bar_index, entryPrice, bar_index, tpPrice, border_color=color.new(color.white, 100), bgcolor=color.new(color.green, 85))

    infoLabel := label.new(bar_index, slPrice, "SHORT\nEntry: " + str.tostring(entryPrice, format.mintick) + "\nSL: " + str.tostring(slPrice, format.mintick) + "\nTP: " + str.tostring(tpPrice, format.mintick) + "\nScore: " + str.tostring(shortScore) + "/5", style=label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)

// Keep drawings extending while a trade is active
if tradeDir != 0
    line.set_x2(entryLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tpLine, bar_index)
    box.set_right(riskBox, bar_index)
    box.set_right(rewardBox, bar_index)

// Resolve trade: TP hit, SL hit, or expiry
if tradeDir == 1
    if high >= tpPrice
        label.new(bar_index, tpPrice, "TP HIT", style=label.style_label_down, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
        tradeDir := 0
    else if low <= slPrice
        label.new(bar_index, slPrice, "SL HIT", style=label.style_label_up, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
        tradeDir := 0
    else if expiryBars > 0 and (bar_index - entryBarIdx) > expiryBars
        label.new(bar_index, entryPrice, "EXPIRED", style=label.style_label_left, color=color.new(color.gray, 0), textcolor=color.white, size=size.small)
        tradeDir := 0

if tradeDir == -1
    if low <= tpPrice
        label.new(bar_index, tpPrice, "TP HIT", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
        tradeDir := 0
    else if high >= slPrice
        label.new(bar_index, slPrice, "SL HIT", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
        tradeDir := 0
    else if expiryBars > 0 and (bar_index - entryBarIdx) > expiryBars
        label.new(bar_index, entryPrice, "EXPIRED", style=label.style_label_left, color=color.new(color.gray, 0), textcolor=color.white, size=size.small)
        tradeDir := 0

// ============================================================================
// PLOTS
// ============================================================================
plot(emaFast, "Fast EMA", color=color.new(color.aqua, 0))
plot(emaSlow, "Slow EMA", color=color.new(color.orange, 0))

plotshape(longTrigger,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(shortTrigger, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.small)

bgcolor(showTrendBg ? (htfBias == 1 ? color.new(color.green, 92) : htfBias == -1 ? color.new(color.red, 92) : na) : na, title="HTF Trend Background")

// ============================================================================
// ANALYSIS PANEL
// ============================================================================
var table infoTable = table.new(position.top_right, 2, 8, border_width=1)

if showTable and barstate.islast
    table.cell(infoTable, 0, 0, "Chart Analyzer", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.small)
    table.cell(infoTable, 1, 0, "", bgcolor=color.new(color.blue, 0))

    table.cell(infoTable, 0, 1, "HTF Bias (" + htf1 + ")", text_size=size.small)
    table.cell(infoTable, 1, 1, htfBias == 1 ? "Bullish" : htfBias == -1 ? "Bearish" : "Flat", text_color=htfBias == 1 ? color.green : htfBias == -1 ? color.red : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 2, "Mid Bias (" + htf2 + ")", text_size=size.small)
    table.cell(infoTable, 1, 2, midBias == 1 ? "Bullish" : "Bearish", text_color=midBias == 1 ? color.green : color.red, text_size=size.small)

    table.cell(infoTable, 0, 3, "Chart Bias", text_size=size.small)
    table.cell(infoTable, 1, 3, localBias == 1 ? "Bullish" : "Bearish", text_color=localBias == 1 ? color.green : color.red, text_size=size.small)

    table.cell(infoTable, 0, 4, "RSI", text_size=size.small)
    table.cell(infoTable, 1, 4, str.tostring(rsiVal, "#.##"), text_size=size.small)

    table.cell(infoTable, 0, 5, "Long / Short Score", text_size=size.small)
    table.cell(infoTable, 1, 5, str.tostring(longScore) + "/5  |  " + str.tostring(shortScore) + "/5", text_size=size.small)

    table.cell(infoTable, 0, 6, "Active Trade", text_size=size.small)
    table.cell(infoTable, 1, 6, tradeDir == 1 ? "LONG" : tradeDir == -1 ? "SHORT" : "None", text_color=tradeDir == 1 ? color.green : tradeDir == -1 ? color.red : color.gray, text_size=size.small)

    table.cell(infoTable, 0, 7, "Entry / SL / TP", text_size=size.small)
    table.cell(infoTable, 1, 7, tradeDir != 0 ? str.tostring(entryPrice, format.mintick) + " / " + str.tostring(slPrice, format.mintick) + " / " + str.tostring(tpPrice, format.mintick) : "-", text_size=size.small)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(longTrigger,  title="Long Entry Signal",  message="LONG signal on {{ticker}} @ {{close}} — check chart for SL/TP")
alertcondition(shortTrigger, title="Short Entry Signal",  message="SHORT signal on {{ticker}} @ {{close}} — check chart for SL/TP")
