//@version=6
// Simple Entry / Stop / Target
// The plan is built on a FIXED timeframe (default Daily) no matter which chart
// you are looking at, so switching the chart view never moves the levels. It
// waits until at least a month of history is loaded, then locks one plan and
// holds it until price hits it or it is invalidated.
// Only three levels are drawn: entry, stop loss, take profit.
indicator("Simple Entry / SL / TP", overlay=true, max_lines_count=20, max_labels_count=20)

gPlan = "Plan"
gA    = "Analysis"
gV    = "Volume"
gP    = "Patterns"
gT    = "Trade"
gD    = "Display"

// ============================================================================
// PLAN SETTINGS — what the analysis is anchored to
// ============================================================================
planTFsel  = input.string("Daily", "Plan Timeframe (levels come from this, not the chart)", options=["Chart", "Daily", "Weekly", "Monthly"], group=gPlan)
minHistDay = input.int(30, "Minimum History Before Planning (days)", minval=1, group=gPlan)
lockMode   = input.string("Hold until hit or invalidated", "Plan Updates", options=["Hold until hit or invalidated", "Recalculate every bar"], group=gPlan)
relockFlip = input.bool(true, "Invalidate plan if trend direction flips", group=gPlan)

fastLen   = input.int(20,  "Trend EMA (fast)", group=gA)
slowLen   = input.int(50,  "Trend EMA (slow)", group=gA)
pivotLen  = input.int(10,  "Structure Lookback (swing size)", group=gA)
maxSwings = input.int(6,   "Swings Remembered", minval=2, group=gA)
rangeLen  = input.int(40,  "Range Lookback", group=gA)
atrLen    = input.int(14,  "ATR Length", group=gA)
adxLen    = input.int(14,  "Trend Strength (ADX) Length", group=gA)
adxMin    = input.float(20.0, "Treat as trending above ADX", step=1.0, group=gA)
useRound  = input.bool(true, "Include round-number levels", group=gA)
holdBars  = input.int(3, "Direction Stability (bars)", minval=1, group=gA)
trendMin  = input.int(60, "Trend Score needed to follow trend (0-100)", minval=0, maxval=100, group=gA)

volLen    = input.int(20, "Volume Average Length", group=gV)
volSpike  = input.float(1.5, "Breakout Volume Multiple", step=0.1, group=gV)
useVolume = input.bool(true, "Require volume to confirm trend", group=gV)

usePatterns = input.bool(true, "Trade chart patterns when found", group=gP)
poleLen     = input.int(20, "Impulse (pole) Lookback", group=gP)
flagLen     = input.int(10, "Consolidation (flag) Lookback", group=gP)

maxDistA  = input.float(4.0, "Max Entry Distance (ATR)", step=0.5, group=gT)
slBuffer  = input.float(1.0, "Stop Buffer (ATR)", step=0.1, group=gT)
minStopA  = input.float(1.0, "Minimum Stop Distance (ATR)", step=0.1, group=gT)
minRR     = input.float(2.0, "Minimum Reward:Risk", step=0.1, group=gT)
extRatio  = input.float(1.272, "Target Extension (Fib)", step=0.1, group=gT)
tpMode    = input.string("Structure + min R", "Take Profit", options=["Structure + min R", "Fixed R multiple"], group=gT)

projBars   = input.int(30, "Project Forward (bars)", group=gD)
showStatus = input.bool(true, "Show analysis status", group=gD)

// ============================================================================
// ANCHOR TIMEFRAMES — the plan timeframe and the one above it for context
// ============================================================================
chartAutoHTF = timeframe.isseconds ? "60" : timeframe.isintraday ? (timeframe.multiplier <= 15 ? "240" : "D") : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"

planTF   = planTFsel == "Chart" ? timeframe.period : planTFsel == "Daily" ? "D" : planTFsel == "Weekly" ? "W" : "M"
higherTF = planTFsel == "Chart" ? chartAutoHTF : planTFsel == "Daily" ? "W" : planTFsel == "Weekly" ? "M" : "12M"

// ============================================================================
// ALL MEASUREMENTS TAKEN ON THE PLAN TIMEFRAME
// (this is why changing the chart timeframe no longer moves the levels)
// ============================================================================
aClose                       = request.security(syminfo.tickerid, planTF, close, lookahead=barmerge.lookahead_off)
[aAtr, aEmaF, aEmaS]         = request.security(syminfo.tickerid, planTF, [ta.atr(atrLen), ta.ema(close, fastLen), ta.ema(close, slowLen)], lookahead=barmerge.lookahead_off)
[aDiP, aDiM, aAdx]           = request.security(syminfo.tickerid, planTF, ta.dmi(adxLen, adxLen), lookahead=barmerge.lookahead_off)
[aPh, aPl]                   = request.security(syminfo.tickerid, planTF, [ta.pivothigh(high, pivotLen, pivotLen), ta.pivotlow(low, pivotLen, pivotLen)], lookahead=barmerge.lookahead_off)
[aRngHi, aRngLo]             = request.security(syminfo.tickerid, planTF, [ta.highest(high, rangeLen), ta.lowest(low, rangeLen)], lookahead=barmerge.lookahead_off)
[aVolNow, aVolAvg]           = request.security(syminfo.tickerid, planTF, [volume, ta.sma(volume, volLen)], lookahead=barmerge.lookahead_off)
[aObv, aObvSig]              = request.security(syminfo.tickerid, planTF, [ta.obv, ta.ema(ta.obv, volLen)], lookahead=barmerge.lookahead_off)
[aUpVol, aDnVol]             = request.security(syminfo.tickerid, planTF, [math.sum(close > open ? volume : 0.0, volLen), math.sum(close < open ? volume : 0.0, volLen)], lookahead=barmerge.lookahead_off)
[aPoleLo, aPoleHi, aFlagHi, aFlagLo] = request.security(syminfo.tickerid, planTF, [ta.lowest(low, poleLen + flagLen), ta.highest(high, poleLen + flagLen), ta.highest(high, flagLen), ta.lowest(low, flagLen)], lookahead=barmerge.lookahead_off)
[aVolFlag, aVolPole]         = request.security(syminfo.tickerid, planTF, [ta.sma(volume, flagLen), ta.sma(volume, poleLen)], lookahead=barmerge.lookahead_off)
htfDiff                      = request.security(syminfo.tickerid, higherTF, ta.ema(close, fastLen) - ta.ema(close, slowLen), lookahead=barmerge.lookahead_off)

trending = aAdx >= adxMin
dmiBias  = aDiP > aDiM ? 1 : -1
maUp     = na(aEmaS) ? aClose > aEmaF : (aClose > aEmaF and aEmaF > aEmaS)
maDown   = na(aEmaS) ? aClose < aEmaF : (aClose < aEmaF and aEmaF < aEmaS)
htfBias  = na(htfDiff) ? 0 : (htfDiff > 0 ? 1 : -1)

// ============================================================================
// MARKET STRUCTURE — higher highs / higher lows is the definition of an uptrend
// ============================================================================
var float swHi = na
var float swLo = na
var pHighs = array.new_float()
var pLows  = array.new_float()

// The requested pivot repeats for every chart bar inside one plan-timeframe bar,
// so only store it when it is genuinely a new swing.
if not na(aPh) and (na(swHi) or aPh != swHi)
    swHi := aPh
    array.push(pHighs, aPh)
    if array.size(pHighs) > maxSwings
        array.shift(pHighs)
if not na(aPl) and (na(swLo) or aPl != swLo)
    swLo := aPl
    array.push(pLows, aPl)
    if array.size(pLows) > maxSwings
        array.shift(pLows)

back(a, k) =>
    array.size(a) > k ? array.get(a, array.size(a) - 1 - k) : na

hi0 = back(pHighs, 0)
hi1 = back(pHighs, 1)
lo0 = back(pLows,  0)
lo1 = back(pLows,  1)

higherHighs = not na(hi0) and not na(hi1) and hi0 > hi1
higherLows  = not na(lo0) and not na(lo1) and lo0 > lo1
lowerHighs  = not na(hi0) and not na(hi1) and hi0 < hi1
lowerLows   = not na(lo0) and not na(lo1) and lo0 < lo1

structUp   = higherHighs and higherLows
structDown = lowerHighs and lowerLows

bosUp   = not na(hi0) and aClose > hi0
bosDown = not na(lo0) and aClose < lo0

haveLeg  = not na(swHi) and not na(swLo)
legRange = haveLeg ? math.abs(swHi - swLo) : na

rngSize  = math.max(aRngHi - aRngLo, syminfo.mintick)
rangePos = (aClose - aRngLo) / rngSize

// ============================================================================
// VOLUME — does participation actually back the move?
// ============================================================================
hasVol  = not na(aVolAvg) and aVolAvg > 0
obvUp   = hasVol and not na(aObvSig) and aObv > aObvSig
obvDown = hasVol and not na(aObvSig) and aObv < aObvSig
volBull = hasVol and aUpVol > aDnVol
volBear = hasVol and aDnVol > aUpVol
volExpand = hasVol and aVolNow > aVolAvg * volSpike

volConfirmsUp   = obvUp and volBull
volConfirmsDown = obvDown and volBear

// ============================================================================
// TREND SCORE (0-100) — four independent angles
// ============================================================================
scoreUp = 0
scoreUp += structUp ? 30 : higherLows or higherHighs ? 15 : 0
scoreUp += maUp ? 20 : 0
scoreUp += (trending and dmiBias == 1) ? 15 : 0
scoreUp += htfBias == 1 ? 10 : 0
scoreUp += not hasVol ? 13 : volConfirmsUp ? 25 : obvUp or volBull ? 12 : 0

scoreDn = 0
scoreDn += structDown ? 30 : lowerHighs or lowerLows ? 15 : 0
scoreDn += maDown ? 20 : 0
scoreDn += (trending and dmiBias == -1) ? 15 : 0
scoreDn += htfBias == -1 ? 10 : 0
scoreDn += not hasVol ? 13 : volConfirmsDown ? 25 : obvDown or volBear ? 12 : 0

volVetoUp   = useVolume and hasVol and volConfirmsDown
volVetoDown = useVolume and hasVol and volConfirmsUp

upTrend   = scoreUp >= trendMin and scoreUp > scoreDn and not volVetoUp
downTrend = scoreDn >= trendMin and scoreDn > scoreUp and not volVetoDown
trendMode = upTrend or downTrend

biasTrend = upTrend ? 1 : downTrend ? -1 : (scoreUp >= scoreDn ? 1 : -1)
biasRange = rangePos > 0.5 ? -1 : 1
rawBias   = trendMode ? biasTrend : biasRange

var int heldBias    = 0
var int pendingBias = 0
var int pendingCnt  = 0

if heldBias == 0
    heldBias := rawBias
else if rawBias == heldBias
    pendingBias := 0
    pendingCnt  := 0
else
    pendingCnt  := rawBias == pendingBias ? pendingCnt + 1 : 1
    pendingBias := rawBias
    if pendingCnt >= holdBars
        heldBias   := rawBias
        pendingCnt := 0

bias = heldBias

// ============================================================================
// CHART PATTERNS
// ============================================================================
flagRange  = aFlagHi - aFlagLo
volFlagDry = hasVol and aVolFlag < aVolPole
poleSize   = aPoleHi - aPoleLo
strongPole = poleSize > aAtr * 3 and flagRange < poleSize * 0.5 and (not hasVol or volFlagDry)

bullFlag = usePatterns and strongPole and aClose > aPoleLo + poleSize * 0.5 and (higherLows or maUp)
bearFlag = usePatterns and strongPole and aClose < aPoleHi - poleSize * 0.5 and (lowerHighs or maDown)

doubleBottom = usePatterns and not na(lo0) and not na(lo1) and math.abs(lo0 - lo1) <= aAtr * 0.75 and not na(hi0) and hi0 > math.max(lo0, lo1) and aClose > math.max(lo0, lo1)
doubleTop    = usePatterns and not na(hi0) and not na(hi1) and math.abs(hi0 - hi1) <= aAtr * 0.75 and not na(lo0) and lo0 < math.min(hi0, hi1) and aClose < math.min(hi0, hi1)

ascTriangle  = usePatterns and not na(hi0) and not na(hi1) and math.abs(hi0 - hi1) <= aAtr * 0.5 and higherLows
descTriangle = usePatterns and not na(lo0) and not na(lo1) and math.abs(lo0 - lo1) <= aAtr * 0.5 and lowerHighs

breakoutUp   = usePatterns and bosUp   and volExpand
breakoutDown = usePatterns and bosDown and volExpand

patternName = breakoutUp ? "volume breakout" : breakoutDown ? "volume breakdown" : bullFlag ? "bull flag" : bearFlag ? "bear flag" : doubleBottom ? "double bottom" : doubleTop ? "double top" : ascTriangle ? "ascending triangle" : descTriangle ? "descending triangle" : structUp ? "uptrend (HH/HL)" : structDown ? "downtrend (LH/LL)" : trendMode ? "trend" : "range"

// ============================================================================
// LEVEL SELECTION HELPERS
// ============================================================================
pickLevel(arr, isLong, tol) =>
    float best = na
    int bestScore = -1
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = array.get(arr, i)
            int sc = 0
            for j = 0 to array.size(arr) - 1
                if math.abs(array.get(arr, j) - lv) <= tol
                    sc += 1
            better = sc > bestScore or (sc == bestScore and (isLong ? lv > best : lv < best))
            if better
                bestScore := sc
                best := lv
    best

nearestSide(arr, isLong, ref) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = array.get(arr, i)
            ok = isLong ? lv < ref : lv > ref
            if ok and (na(best) or (isLong ? lv > best : lv < best))
                best := lv
    best

// ============================================================================
// CANDIDATE PLAN (recomputed every bar; only committed when allowed)
// ============================================================================
float entry  = na
float stopL  = na
float target = na
string planTxt = "confluence pullback"

if not na(aAtr) and aAtr > 0
    float pEntry = na
    float pStop  = na
    float pTgt   = na

    if bias == 1 and bullFlag
        pEntry  := aFlagLo + flagRange * 0.25
        pStop   := aFlagLo - aAtr * slBuffer
        pTgt    := pEntry + poleSize
        planTxt := "bull flag: buy flag support, target measured move"
    else if bias == 1 and doubleBottom
        neck    = hi0
        pEntry  := math.min(neck, aClose) - aAtr * 0.25
        pStop   := math.min(lo0, lo1) - aAtr * slBuffer
        pTgt    := neck + (neck - math.min(lo0, lo1))
        planTxt := "double bottom: buy neckline retest, target pattern height"
    else if bias == 1 and ascTriangle
        pEntry  := math.max(lo0, aClose - aAtr)
        pStop   := lo0 - aAtr * slBuffer
        pTgt    := hi0 + (hi0 - lo0)
        planTxt := "ascending triangle: buy rising support, target breakout move"
    else if bias == 1 and breakoutUp
        pEntry  := hi0
        pStop   := hi0 - math.max(aAtr * slBuffer, flagRange * 0.5)
        pTgt    := hi0 + poleSize * 0.75
        planTxt := "volume breakout: buy the retest, ride the expansion"
    else if bias == -1 and bearFlag
        pEntry  := aFlagHi - flagRange * 0.25
        pStop   := aFlagHi + aAtr * slBuffer
        pTgt    := pEntry - poleSize
        planTxt := "bear flag: sell flag resistance, target measured move"
    else if bias == -1 and doubleTop
        neck2   = lo0
        pEntry  := math.max(neck2, aClose) + aAtr * 0.25
        pStop   := math.max(hi0, hi1) + aAtr * slBuffer
        pTgt    := neck2 - (math.max(hi0, hi1) - neck2)
        planTxt := "double top: sell neckline retest, target pattern height"
    else if bias == -1 and breakoutDown
        pEntry  := lo0
        pStop   := lo0 + math.max(aAtr * slBuffer, flagRange * 0.5)
        pTgt    := lo0 - poleSize * 0.75
        planTxt := "volume breakdown: sell the retest, ride the expansion"

    patOk = not na(pEntry) and (bias == 1 ? pEntry < aClose : pEntry > aClose) and math.abs(aClose - pEntry) <= aAtr * maxDistA

    if patOk
        entry := pEntry
        stopL := pStop
    else
        planTxt := trendMode ? "trend pullback into confluence" : "range: fade the edge"
        tol     = aAtr * 0.5
        levels  = array.new_float()

        if trendMode and haveLeg
            if bias == 1
                array.push(levels, swHi - legRange * 0.382)
                array.push(levels, swHi - legRange * 0.5)
                array.push(levels, swHi - legRange * 0.618)
            else
                array.push(levels, swLo + legRange * 0.382)
                array.push(levels, swLo + legRange * 0.5)
                array.push(levels, swLo + legRange * 0.618)
            array.push(levels, aEmaF)
        else
            if bias == 1
                array.push(levels, aRngLo + rngSize * 0.15)
                array.push(levels, aRngLo)
            else
                array.push(levels, aRngHi - rngSize * 0.15)
                array.push(levels, aRngHi)

        src = bias == 1 ? pLows : pHighs
        if array.size(src) > 0
            for i = 0 to array.size(src) - 1
                array.push(levels, array.get(src, i))
        flip = bias == 1 ? pHighs : pLows
        if array.size(flip) > 0
            for i = 0 to array.size(flip) - 1
                array.push(levels, array.get(flip, i))

        if useRound
            roundStep = math.pow(10, math.floor(math.log10(math.max(aClose, syminfo.mintick))) - 1)
            if roundStep > 0
                base = bias == 1 ? math.floor(aClose / roundStep) * roundStep : math.ceil(aClose / roundStep) * roundStep
                array.push(levels, base)
                array.push(levels, bias == 1 ? base - roundStep : base + roundStep)

        reach = array.new_float()
        side  = array.new_float()
        if array.size(levels) > 0
            for i = 0 to array.size(levels) - 1
                lv = array.get(levels, i)
                if not na(lv) and (bias == 1 ? lv < aClose : lv > aClose)
                    array.push(side, lv)
                    if math.abs(aClose - lv) <= aAtr * maxDistA
                        array.push(reach, lv)

        confluent = pickLevel(reach, bias == 1, tol)
        nearest   = nearestSide(side, bias == 1, aClose)
        if not na(confluent)
            entry := confluent
        else if not na(nearest)
            entry := nearest
        else
            entry := bias == 1 ? aClose - 0.5 * aAtr : aClose + 0.5 * aAtr

        anchor  = trendMode and haveLeg ? (bias == 1 ? math.min(swLo, entry) : math.max(swHi, entry)) : (bias == 1 ? math.min(aRngLo, entry) : math.max(aRngHi, entry))
        stopL  := bias == 1 ? anchor - aAtr * slBuffer : anchor + aAtr * slBuffer

    stopDist = math.max(math.abs(entry - stopL), aAtr * minStopA)
    stopL   := bias == 1 ? entry - stopDist : entry + stopDist

    risk    = math.max(math.abs(entry - stopL), syminfo.mintick)
    rTarget = bias == 1 ? entry + risk * minRR : entry - risk * minRR

    float sTarget = na
    if patOk and not na(pTgt)
        sTarget := pTgt
    else if trendMode and haveLeg
        sTarget := bias == 1 ? swLo + legRange * extRatio : swHi - legRange * extRatio
    else
        sTarget := bias == 1 ? aRngHi - rngSize * 0.1 : aRngLo + rngSize * 0.1

    target := tpMode == "Fixed R multiple" or na(sTarget) ? rTarget : (bias == 1 ? math.max(sTarget, rTarget) : math.min(sTarget, rTarget))

// ============================================================================
// HISTORY GATE — do not plan until enough chart history has actually loaded
// ============================================================================
var int firstTime = na
if na(firstTime)
    firstTime := time
spanDays  = (time - firstTime) / 86400000.0
historyOk = spanDays >= minHistDay
dataOk    = not na(aAtr) and not na(aEmaF) and not na(aRngHi) and not na(entry) and not na(stopL) and not na(target)
canPlan   = historyOk and dataOk

// ============================================================================
// PLAN LOCK — commit one plan and hold it steady
// ============================================================================
var float planEntry = na
var float planStop  = na
var float planTgt   = na
var int   planBias  = 0
var bool  planOn    = false
var int   planBarIx = na
var string planNote = ""
var string planPat  = ""

liveMode = lockMode == "Recalculate every bar"

if liveMode
    if canPlan
        planEntry := entry
        planStop  := stopL
        planTgt   := target
        planBias  := bias
        planNote  := planTxt
        planPat   := patternName
        planBarIx := bar_index
        planOn    := true
else
    if planOn
        // Invalidate once price resolves the plan or the read changes materially
        hitStop = planBias == 1 ? low <= planStop : high >= planStop
        hitTgt  = planBias == 1 ? high >= planTgt : low <= planTgt
        flipped = relockFlip and bias != planBias
        if hitStop or hitTgt or flipped
            planOn := false
    if not planOn and canPlan
        planEntry := entry
        planStop  := stopL
        planTgt   := target
        planBias  := bias
        planNote  := planTxt
        planPat   := patternName
        planBarIx := bar_index
        planOn    := true

// ============================================================================
// DRAW — only the three committed levels
// ============================================================================
var line  eLine = na
var line  sLine = na
var line  tLine = na
var label eLab  = na
var label sLab  = na
var label tLab  = na

if barstate.islast and planOn and not na(planEntry)
    line.delete(eLine)
    line.delete(sLine)
    line.delete(tLine)
    label.delete(eLab)
    label.delete(sLab)
    label.delete(tLab)

    x1 = math.max(0, bar_index - 50)
    x2 = bar_index + projBars

    eLine := line.new(x1, planEntry, x2, planEntry, color=color.new(color.blue,  0), width=2)
    sLine := line.new(x1, planStop,  x2, planStop,  color=color.new(color.red,   0), width=2, style=line.style_dashed)
    tLine := line.new(x1, planTgt,   x2, planTgt,   color=color.new(color.green, 0), width=2, style=line.style_dashed)

    eLab := label.new(bar_index, planEntry, (planBias == 1 ? "LONG ENTRY " : "SHORT ENTRY ") + str.tostring(planEntry, format.mintick), style=label.style_label_left, color=color.new(color.blue,  0), textcolor=color.white, size=size.normal)
    sLab := label.new(bar_index, planStop,  "STOP LOSS "   + str.tostring(planStop, format.mintick), style=label.style_label_left, color=color.new(color.red,   0), textcolor=color.white, size=size.normal)
    tLab := label.new(bar_index, planTgt,   "TAKE PROFIT " + str.tostring(planTgt,  format.mintick), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)

// ============================================================================
// STATUS
// ============================================================================
tfLabel(tf) =>
    tf == "D" ? "Daily" : tf == "W" ? "Weekly" : tf == "M" ? "Monthly" : tf == "12M" ? "Yearly" : tf

planTFtxt  = planTFsel == "Chart" ? "Chart (" + timeframe.period + ")" : tfLabel(planTF)
chartTooBig = timeframe.in_seconds(timeframe.period) > timeframe.in_seconds(planTF)

verdict = upTrend ? "UPTREND" : downTrend ? "DOWNTREND" : "NO CLEAR TREND"
volTxt  = not hasVol ? "no volume data" : volConfirmsUp ? "volume confirms buying" : volConfirmsDown ? "volume confirms selling" : obvUp ? "OBV rising" : obvDown ? "OBV falling" : "volume mixed"

distPct = planOn ? math.abs(close - planEntry) / close * 100 : na
rrNow   = planOn ? math.abs(planTgt - planEntry) / math.max(math.abs(planEntry - planStop), syminfo.mintick) : na
ageBars = planOn and not na(planBarIx) ? bar_index - planBarIx : 0

readyTxt = "✔ PLAN LOCKED on " + planTFtxt + " · " + syminfo.ticker + " · " + str.tostring(spanDays, "#") + " days of history read" + (liveMode ? "" : "\nHolding this plan — it will not move until price hits it or the trend flips (set " + str.tostring(ageBars) + " bars ago)") + "\n" + verdict + "  (up " + str.tostring(scoreUp) + "/100 · down " + str.tostring(scoreDn) + "/100) · " + volTxt + "\nPattern: " + planPat + "\nPlan: " + planNote + "\n" + (planBias == 1 ? "LONG" : "SHORT") + " · entry " + str.tostring(distPct, "#.##") + "% away · R:R " + str.tostring(rrNow, "#.##") + (chartTooBig ? "\n⚠ Chart timeframe is above the plan timeframe — view " + planTFtxt + " or lower for accurate structure" : "")

waitTxt = "⏳ COLLECTING HISTORY — " + syminfo.ticker + " · plan timeframe " + planTFtxt + "\n" + (not historyOk ? "need " + str.tostring(minHistDay) + " days, have " + str.tostring(spanDays, "#") + " — scroll left to load more history" : "waiting for " + planTFtxt + " indicators to fill")

var table stTable = table.new(position.bottom_left, 1, 1, border_width=1)
if showStatus and barstate.islast
    bg = not planOn ? color.new(color.orange, 15) : planBias == 1 ? color.new(color.green, 15) : color.new(color.red, 25)
    table.cell(stTable, 0, 0, planOn ? readyTxt : waitTxt, text_color=color.white, bgcolor=bg, text_size=size.small, text_halign=text.align_left)

// ============================================================================
// ALERTS
// ============================================================================
reachedEntry = planOn and not na(planEntry) and (planBias == 1 ? (low <= planEntry and low[1] > planEntry) : (high >= planEntry and high[1] < planEntry))
alertcondition(reachedEntry, title="Price reached entry", message="{{ticker}} reached the planned entry — check stop and target")
alertcondition(upTrend and not upTrend[1],     title="Uptrend confirmed",   message="{{ticker}} confirmed an uptrend (structure + volume)")
alertcondition(downTrend and not downTrend[1], title="Downtrend confirmed", message="{{ticker}} confirmed a downtrend (structure + volume)")
