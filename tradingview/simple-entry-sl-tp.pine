//@version=5
// Simple Entry / Stop / Target
// Reads whatever timeframe the chart is showing (days, weeks, months, intraday)
// and projects ONE current setup: an entry price you can still get filled at,
// a stop loss, and a take profit. Nothing else is drawn.
indicator("Simple Entry / SL / TP", overlay=true, max_lines_count=20, max_labels_count=20)

// ============================================================================
// INPUTS
// ============================================================================
trendLen = input.int(20,  "Trend EMA (fast)")
slowLen  = input.int(50,  "Trend EMA (slow)")
pivotLen = input.int(10,  "Structure Lookback")
atrLen   = input.int(14,  "ATR Length")
slBuffer = input.float(1.0, "Stop Buffer (ATR)", step=0.1)
rr       = input.float(2.0, "Take Profit (R multiple)", step=0.1)
projBars = input.int(30,  "Project Forward (bars)")

// ============================================================================
// TREND DIRECTION (from the chart's own timeframe)
// ============================================================================
atrVal = ta.atr(atrLen)
emaF   = ta.ema(close, trendLen)
emaS   = ta.ema(close, slowLen)

// If there isn't enough history for the slow EMA (common on weekly/monthly),
// fall back to price vs. the fast EMA.
isUp = na(emaS) ? close > emaF : emaF > emaS
bias  = isUp ? 1 : -1

// ============================================================================
// STRUCTURE (last confirmed swing high / low)
// ============================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

// ============================================================================
// ENTRY — a level price still has to reach, so it is actually fillable
//   Uptrend   -> buy the pullback: nearest support BELOW current price
//   Downtrend -> sell the bounce:  nearest resistance ABOVE current price
// ============================================================================
supEma = emaF < close ? emaF : na
supPiv = (not na(lastPL) and lastPL < close) ? lastPL : na
support = na(supEma) and na(supPiv) ? close - 0.5 * atrVal : na(supEma) ? supPiv : na(supPiv) ? supEma : math.max(supEma, supPiv)

resEma = emaF > close ? emaF : na
resPiv = (not na(lastPH) and lastPH > close) ? lastPH : na
resist = na(resEma) and na(resPiv) ? close + 0.5 * atrVal : na(resEma) ? resPiv : na(resPiv) ? resEma : math.min(resEma, resPiv)

entry = bias == 1 ? support : resist

// ============================================================================
// STOP & TARGET
// ============================================================================
slBase = bias == 1 ? math.min(na(lastPL) ? entry : lastPL, entry) - atrVal * slBuffer : math.max(na(lastPH) ? entry : lastPH, entry) + atrVal * slBuffer

risk = math.max(math.abs(entry - slBase), syminfo.mintick)
tp   = bias == 1 ? entry + risk * rr : entry - risk * rr

// ============================================================================
// DRAW — only the three levels, refreshed on the latest bar
// ============================================================================
var line  eLine = na
var line  sLine = na
var line  tLine = na
var label eLab  = na
var label sLab  = na
var label tLab  = na

if barstate.islast and not na(atrVal) and not na(entry)
    line.delete(eLine)
    line.delete(sLine)
    line.delete(tLine)
    label.delete(eLab)
    label.delete(sLab)
    label.delete(tLab)

    x1 = math.max(0, bar_index - 50)
    x2 = bar_index + projBars

    eLine := line.new(x1, entry,  x2, entry,  color=color.new(color.blue,  0), width=2)
    sLine := line.new(x1, slBase, x2, slBase, color=color.new(color.red,   0), width=2, style=line.style_dashed)
    tLine := line.new(x1, tp,     x2, tp,     color=color.new(color.green, 0), width=2, style=line.style_dashed)

    // Anchored at the current bar so they stay on screen; text extends right.
    eLab := label.new(bar_index, entry,  (bias == 1 ? "LONG ENTRY " : "SHORT ENTRY ") + str.tostring(entry,  format.mintick), style=label.style_label_left, color=color.new(color.blue,  0), textcolor=color.white, size=size.normal)
    sLab := label.new(bar_index, slBase, "STOP LOSS "   + str.tostring(slBase, format.mintick), style=label.style_label_left, color=color.new(color.red,   0), textcolor=color.white, size=size.normal)
    tLab := label.new(bar_index, tp,     "TAKE PROFIT " + str.tostring(tp,     format.mintick), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)

// ============================================================================
// ALERT (optional — nothing is drawn for this)
// ============================================================================
reachedEntry = bias == 1 ? (low <= entry and low[1] > entry[1]) : (high >= entry and high[1] < entry[1])
alertcondition(reachedEntry, title="Price reached entry", message="{{ticker}} reached the entry level — check stop and target")
