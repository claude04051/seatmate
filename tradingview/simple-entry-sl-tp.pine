//@version=5
// Simple Entry / Stop / Target
// Reads whatever timeframe the chart is showing (days, weeks, months, intraday),
// analyses trend regime, market structure and higher-timeframe context, then
// projects ONE current setup: an entry price you can still get filled at, a stop
// loss, and a take profit. Only those three levels are drawn.
indicator("Simple Entry / SL / TP", overlay=true, max_lines_count=20, max_labels_count=20)

// ============================================================================
// INPUTS
// ============================================================================
fastLen   = input.int(20,  "Trend EMA (fast)")
slowLen   = input.int(50,  "Trend EMA (slow)")
pivotLen  = input.int(10,  "Structure Lookback (swing size)")
rangeLen  = input.int(40,  "Range Lookback")
atrLen    = input.int(14,  "ATR Length")
adxLen    = input.int(14,  "Trend Strength (ADX) Length")
adxMin    = input.float(20.0, "Treat as trending above ADX", step=1.0)
slBuffer  = input.float(1.0, "Stop Buffer (ATR)", step=0.1)
minStopA  = input.float(1.0, "Minimum Stop Distance (ATR)", step=0.1)
minRR     = input.float(2.0, "Minimum Reward:Risk", step=0.1)
extRatio  = input.float(1.272, "Target Extension (Fib)", step=0.1)
tpMode    = input.string("Structure + min R", "Take Profit", options=["Structure + min R", "Fixed R multiple"])
useHTF    = input.bool(true, "Use higher-timeframe context")
projBars  = input.int(30,  "Project Forward (bars)")

// ============================================================================
// CORE MEASURES
// ============================================================================
atrVal = ta.atr(atrLen)
emaF   = ta.ema(close, fastLen)
emaS   = ta.ema(close, slowLen)

// Not enough history for the slow EMA (common on weekly/monthly) -> use price vs fast EMA
chartUp   = na(emaS) ? close > emaF : emaF > emaS
biasTrend = chartUp ? 1 : -1

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
trending = adxVal >= adxMin

// ============================================================================
// HIGHER-TIMEFRAME CONTEXT (derived automatically from the chart timeframe)
//   intraday -> 4H/Daily, daily -> weekly, weekly -> monthly, monthly -> yearly
// ============================================================================
autoHTF = timeframe.isseconds ? "60" : timeframe.isintraday ? (timeframe.multiplier <= 15 ? "240" : "D") : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
htfDiff  = request.security(syminfo.tickerid, autoHTF, ta.ema(close, fastLen) - ta.ema(close, slowLen), lookahead=barmerge.lookahead_off)
htfBias  = not useHTF or na(htfDiff) ? 0 : (htfDiff > 0 ? 1 : -1)
htfAgrees = htfBias == 0 or htfBias == biasTrend

// Trend-following only when the move has strength AND the higher timeframe agrees.
// Otherwise the move is treated as range / counter-trend and faded instead.
trendMode = trending and htfAgrees

// ============================================================================
// MARKET STRUCTURE — last confirmed swings and the leg between them
// ============================================================================
phv = ta.pivothigh(high, pivotLen, pivotLen)
plv = ta.pivotlow(low,  pivotLen, pivotLen)
var float swHi = na
var float swLo = na
var int   swHiBar = na
var int   swLoBar = na
if not na(phv)
    swHi := phv
    swHiBar := bar_index - pivotLen
if not na(plv)
    swLo := plv
    swLoBar := bar_index - pivotLen

haveLeg  = not na(swHi) and not na(swLo)
legRange = haveLeg ? math.abs(swHi - swLo) : na

rngHi    = ta.highest(high, rangeLen)
rngLo    = ta.lowest(low,  rangeLen)
rngSize  = math.max(rngHi - rngLo, syminfo.mintick)
rangePos = (close - rngLo) / rngSize          // 0 = at range low, 1 = at range high

// In a range, fade the extremes: upper half -> look to sell, lower half -> look to buy
biasRange = rangePos > 0.5 ? -1 : 1
bias      = trendMode ? biasTrend : biasRange

// ============================================================================
// ENTRY — confluence of levels price still has to travel to reach
//   Longs  take the best support BELOW price, shorts the best resistance ABOVE.
//   Candidates: Fibonacci retracements of the live leg, the fast EMA and the
//   swing that anchors the leg. Whichever level has the most agreement around
//   it wins; ties go to the level nearest current price.
// ============================================================================
pickLevel(arr, isLong, tol) =>
    float best = na
    int bestScore = -1
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            lv = array.get(arr, i)
            int sc = 0
            for j = 0 to array.size(arr) - 1
                if math.abs(array.get(arr, j) - lv) <= tol
                    sc += 1
            better = sc > bestScore or (sc == bestScore and (isLong ? lv > best : lv < best))
            if better
                bestScore := sc
                best := lv
    best

float entry  = na
float stopL  = na
float target = na

if not na(atrVal)
    tol = atrVal * 0.5
    levels = array.new_float()

    if trendMode and haveLeg
        // Retracement of the current impulse leg
        if bias == 1
            array.push(levels, swHi - legRange * 0.382)
            array.push(levels, swHi - legRange * 0.5)
            array.push(levels, swHi - legRange * 0.618)
            array.push(levels, swLo)
        else
            array.push(levels, swLo + legRange * 0.382)
            array.push(levels, swLo + legRange * 0.5)
            array.push(levels, swLo + legRange * 0.618)
            array.push(levels, swHi)
        array.push(levels, emaF)
    else
        // Range: buy the lower edge, sell the upper edge
        if bias == 1
            array.push(levels, rngLo + rngSize * 0.15)
            array.push(levels, rngLo)
        else
            array.push(levels, rngHi - rngSize * 0.15)
            array.push(levels, rngHi)

    // Keep only levels on the tradable side of price
    valid = array.new_float()
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lv = array.get(levels, i)
            if not na(lv) and (bias == 1 ? lv < close : lv > close)
                array.push(valid, lv)

    entry := array.size(valid) > 0 ? pickLevel(valid, bias == 1, tol) : (bias == 1 ? close - 0.5 * atrVal : close + 0.5 * atrVal)

    // ------------------------------------------------------------------
    // STOP — beyond the structure that invalidates the idea, never inside
    // normal noise (enforced minimum ATR distance)
    // ------------------------------------------------------------------
    anchor = trendMode and haveLeg ? (bias == 1 ? math.min(swLo, entry) : math.max(swHi, entry)) : (bias == 1 ? math.min(rngLo, entry) : math.max(rngHi, entry))
    stopRaw = bias == 1 ? anchor - atrVal * slBuffer : anchor + atrVal * slBuffer
    stopDist = math.max(math.abs(entry - stopRaw), atrVal * minStopA)
    stopL := bias == 1 ? entry - stopDist : entry + stopDist

    // ------------------------------------------------------------------
    // TARGET — structural projection, floored at your minimum reward:risk
    // ------------------------------------------------------------------
    risk = math.max(math.abs(entry - stopL), syminfo.mintick)
    rTarget = bias == 1 ? entry + risk * minRR : entry - risk * minRR
    float sTarget = na
    if trendMode and haveLeg
        sTarget := bias == 1 ? swLo + legRange * extRatio : swHi - legRange * extRatio
    else
        sTarget := bias == 1 ? rngHi - rngSize * 0.1 : rngLo + rngSize * 0.1

    target := tpMode == "Fixed R multiple" or na(sTarget) ? rTarget : (bias == 1 ? math.max(sTarget, rTarget) : math.min(sTarget, rTarget))

// ============================================================================
// DRAW — only the three levels, refreshed on the latest bar
// ============================================================================
var line  eLine = na
var line  sLine = na
var line  tLine = na
var label eLab  = na
var label sLab  = na
var label tLab  = na

if barstate.islast and not na(entry) and not na(stopL) and not na(target)
    line.delete(eLine)
    line.delete(sLine)
    line.delete(tLine)
    label.delete(eLab)
    label.delete(sLab)
    label.delete(tLab)

    x1 = math.max(0, bar_index - 50)
    x2 = bar_index + projBars

    eLine := line.new(x1, entry,  x2, entry,  color=color.new(color.blue,  0), width=2)
    sLine := line.new(x1, stopL,  x2, stopL,  color=color.new(color.red,   0), width=2, style=line.style_dashed)
    tLine := line.new(x1, target, x2, target, color=color.new(color.green, 0), width=2, style=line.style_dashed)

    // Anchored at the current bar so they stay on screen; text extends right.
    eLab := label.new(bar_index, entry,  (bias == 1 ? "LONG ENTRY " : "SHORT ENTRY ") + str.tostring(entry,  format.mintick), style=label.style_label_left, color=color.new(color.blue,  0), textcolor=color.white, size=size.normal)
    sLab := label.new(bar_index, stopL,  "STOP LOSS "   + str.tostring(stopL,  format.mintick), style=label.style_label_left, color=color.new(color.red,   0), textcolor=color.white, size=size.normal)
    tLab := label.new(bar_index, target, "TAKE PROFIT " + str.tostring(target, format.mintick), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)

// ============================================================================
// ALERT (optional — nothing is drawn for this)
// ============================================================================
reachedEntry = not na(entry) and not na(entry[1]) and (bias == 1 ? (low <= entry and low[1] > entry[1]) : (high >= entry and high[1] < entry[1]))
alertcondition(reachedEntry, title="Price reached entry", message="{{ticker}} reached the entry level — check stop and target")
